# Monad RPC
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143

# Operator Wallet (agent's wallet with MON for gas)
OPERATOR_PRIVATE_KEY=0x_your_private_key_here

# Moltbook API (run `bun run register-agent` to get your API key)
MOLTBOOK_API_URL=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=
MOLTBOOK_SUBMOLT=general

# OpenRouter LLM (get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Token (fill after creation)
TOKEN_ADDRESS=
TOKEN_NAME=SanctumForge
TOKEN_SYMBOL=SANCT

# Server
PORT=3002

# Agent Config
AGENT_NAME=The Oracle of SanctumForge
LOOP_INTERVAL_MS=60000
MISSIONARY_INTERVAL_MS=300000
SCRIPTURE_INTERVAL_MS=600000
